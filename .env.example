# Local development needs only these two.
# Leave DATABASE_URL as it is to keep the CMS data in a local file; set a postgres:// address to use Postgres.
DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=change-me-to-a-long-random-string

# The address the site is served from (used in links for search engines and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry form -> Google Sheet. See integrations/google-sheet/Code.gs for how to get these.
ENQUIRY_SHEET_WEBHOOK_URL=
ENQUIRY_SHEET_SECRET=

# Vercel only: where files uploaded in the CMS are kept. Vercel sets this when a Blob store is added.
BLOB_READ_WRITE_TOKEN=
